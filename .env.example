# ═══════════════════════════════════════════════════════════════
# Multilingual Lecture Assistant — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and customize values.

# ── Application ──────────────────────────────────────────────
APP_ENVIRONMENT=development
DEBUG=True
MOCK_MODE=False

# ── Database ─────────────────────────────────────────────────
# SQLite (default for local development):
# DATABASE_URL=sqlite:///data/lecture_assistant.db
#
# PostgreSQL (production):
# DATABASE_URL=postgresql://lecture_user:lecture_pass@localhost:5432/lecture_db

# ── Redis (optional) ────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Whisper Model ────────────────────────────────────────────
# Options: tiny, base, small, medium, large
WHISPER_MODEL=base

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# ── Google Cloud (optional — for real translation) ──────────
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
