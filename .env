# Database Configuration
DATABASE_URL=postgresql://lecture_user:lecture_pass@postgres:5432/lecture_db
# Format for local development: postgresql://lecture_user:lecture_pass@localhost:5432/lecture_db

# Redis Configuration
REDIS_URL=redis://redis:6379
# Format for local development: redis://localhost:6379

# Whisper Configuration
WHISPER_MODEL=base
# Options: tiny, base, small, medium, large

# Google Cloud Configuration (for real translation)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Application Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000
APP_NAME=Multilingual Lecture Assistant
APP_VERSION=1.0.0

# Supported languages (configured in code)
# SUPPORTED_LANGUAGES=ta,hi,te,kn,ml,en

# Logging Level
LOG_LEVEL=INFO
